# ==============================================================================
# โหมดที่ 1: สำหรับคุณ (Central Hub Server / เจ้าของหลัก)
# ==============================================================================
TOKEN=your_discord_token_here
APPLICATION_ID=your_application_id_here
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Discord OAuth2 (เอามาจาก Discord Developer Portal -> OAuth2)
DISCORD_CLIENT_ID=your_application_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# ระบุ Discord User ID ของเจ้าของ (คนอื่นที่ login จะไม่มีสิทธิ์แก้ มีคุณคนเดียวที่แก้ได้)
OWNER_DISCORD_ID=your_discord_user_id_here
SESSION_SECRET=stream-rpc-super-secret-session-key

# ==============================================================================
# โหมดที่ 2: สำหรับผู้อื่น (Client Deployment Node ที่โคลนโค้ดไปรันเอง)
# ==============================================================================
# คนอื่นใส่แค่ 3 บรรทัดนี้เท่านั้น! (ไม่ต้องมี Database, ไม่ต้องใส่ Discord Secret)
# TOKEN=user_discord_token_here
# APPLICATION_ID=user_application_id_here
# CENTRAL_API_URL=https://haidarat-stream-3-1.onrender.com

# ==============================================================================
# Server Configuration (Optional)
# ==============================================================================
PORT=3000
HOST=0.0.0.0
LOGIN_RETRY_DELAY_MS=4000
DEBUG_LOGS=false
